# Copy to .env and fill in real values. Never commit .env.

# --- Database (models/, migrations/) ---
DATABASE_URL=postgresql+psycopg://rayvex:rayvex@localhost:55432/rayvex
TEST_DATABASE_URL=postgresql+psycopg://rayvex:rayvex@localhost:55432/rayvex_test

# --- Redis (services/policy: cooldowns, per-customer daily attempt counts,
# velocity checks) ---
REDIS_URL=redis://localhost:63790/0
TEST_REDIS_URL=redis://localhost:63790/1

# --- RabbitMQ (services/ingestion/queue.py, apps/worker) ---
RABBITMQ_URL=amqp://guest:guest@localhost:56720/
TEST_RABBITMQ_URL=amqp://guest:guest@localhost:56720/

# --- Agent LLM backend (services/agent/orchestrator.py) ---
# Set exactly one. Groq is checked first if both are set.
# GROQ_API_KEY=
# OPENAI_API_KEY=

# --- Razorpay Test Mode (services/payments/razorpay_provider.py) ---
# Both required to use RazorpayProvider; falls back to SimulationProvider
# when absent (services/payments/provider_factory.py). Test Mode
# credentials only — never real/live keys.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- Webhook signature verification (apps/api/routers/webhooks.py) ---
# Required for POST /webhooks/razorpay to accept anything — the endpoint
# returns 500 without it rather than silently skipping verification. Set
# to your Razorpay Test Mode webhook secret.
RAZORPAY_WEBHOOK_SECRET=demo_webhook_secret

# --- Recovery-probability estimator (services/recovery/probability_factory.py) ---
# "empirical" (default) or "lightgbm" (requires a trained MLModelRun).
# RECOVERY_PROBABILITY_ESTIMATOR=empirical

# --- Dashboard API auth (apps/api/auth.py, services/accounts/) ---
# One-time bootstrap: on API startup, any "username:password:role" entry
# here that doesn't already exist as a user is created. Anyone can also
# self-register via POST /auth/register (always as viewer); reviewer is
# granted by an existing reviewer via POST /auth/promote. In production,
# set this once to create the first reviewer account, then unset it.
DASHBOARD_CREDENTIALS=demo_viewer:demo_viewer_pw:viewer,demo_reviewer:demo_reviewer_pw:reviewer

# --- CORS (apps/api/main.py) ---
# Comma-separated list of origins allowed to call the API. Set to your
# deployed frontend's real origin(s) in production.
CORS_ORIGINS=http://localhost:3000
