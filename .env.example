# Copy to .env and fill in real values. Never commit .env.
# Only variables actually consumed by code that exists so far are listed here —
# more are added as each subsystem (ingestion, agent, provider, etc.) is built.

# --- Database (models/, migrations/) ---
DATABASE_URL=postgresql+psycopg://rayvex:rayvex@localhost:55432/rayvex
TEST_DATABASE_URL=postgresql+psycopg://rayvex:rayvex@localhost:55432/rayvex_test

# --- Redis (services/policy: cooldowns, per-customer daily attempt counts,
# velocity checks) ---
REDIS_URL=redis://localhost:63790/0
TEST_REDIS_URL=redis://localhost:63790/1

# --- RabbitMQ (services/ingestion/queue.py, apps/worker) — decouples
# webhook ingestion from case processing. Tests reuse the same
# broker/vhost as dev (no separate DB-index-style isolation the way
# Redis has) since the test fixture purges the queue before/after each test,
# same pattern as the redis_client fixture's flushdb(). ---
RABBITMQ_URL=amqp://guest:guest@localhost:56720/
TEST_RABBITMQ_URL=amqp://guest:guest@localhost:56720/

# --- Agent LLM backend (services/agent/orchestrator.py) ---
# Set exactly one. Groq is checked first if both are set. Neither is set
# in this development environment, so the real
# orchestrator.propose() path is untested live here — tests use LangChain's
# own FakeMessagesListChatModel instead (tests/agent/fakes.py). Nothing
# fakes these keys or the real backend classes themselves.
# GROQ_API_KEY=
# OPENAI_API_KEY=

# --- Razorpay Test Mode (services/payments/razorpay_provider.py) ---
# Both required to use RazorpayProvider. Neither is set in this development
# environment, so RazorpayProvider cannot be exercised live here —
# services/payments/provider_factory.py falls back to SimulationProvider
# when they're absent. Test Mode credentials only; never real/live keys.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- Webhook signature verification (apps/api/routers/webhooks.py) ---
# Required for POST /webhooks/razorpay to accept anything — the endpoint
# returns 500 without it, on purpose, rather than silently skipping
# signature verification. Set to whatever secret your Razorpay Test Mode
# webhook is configured with; scripts/seed_demo.py uses its own fixed
# value directly and doesn't read this variable.
RAZORPAY_WEBHOOK_SECRET=demo_webhook_secret

# --- Recovery-probability estimator backend (services/recovery/probability_factory.py) ---
# "empirical" (default, segment-frequency chain) or "lightgbm" (requires a
# trained MLModelRun; see services/ml/training.py).
# RECOVERY_PROBABILITY_ESTIMATOR=empirical

# --- Dashboard API auth (apps/api/auth.py, services/accounts/) ---
# Real accounts live in the `users` table now — anyone can self-register
# via POST /auth/register (always as viewer; reviewer is granted by an
# existing reviewer via POST /auth/promote). This variable is only a
# one-time bootstrap: on API startup, any "username:password:role" entry
# here that doesn't already exist as a user is created — this is what
# gets you the very first reviewer account, since self-registration alone
# can never produce one. Demo-only values, never real credentials.
DASHBOARD_CREDENTIALS=demo_viewer:demo_viewer_pw:viewer,demo_reviewer:demo_reviewer_pw:reviewer
